{
 "Description": "GuardDuty detector con protecciones S3, EKS y Malware habilitadas",
 "Resources": {
  "GuardDutyDetector": {
   "Type": "AWS::GuardDuty::Detector",
   "Properties": {
    "Enable": true,
    "Features": [
     {
      "Name": "S3_DATA_EVENTS",
      "Status": "ENABLED"
     },
     {
      "Name": "EKS_AUDIT_LOGS",
      "Status": "ENABLED"
     },
     {
      "Name": "EBS_MALWARE_PROTECTION",
      "Status": "ENABLED"
     }
    ],
    "FindingPublishingFrequency": "FIFTEEN_MINUTES"
   },
   "Metadata": {
    "aws:cdk:path": "GuardDutyStack/GuardDutyDetector"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/yXGQQqDMBAAwLd4T7YaCj7A3gV9gKTJKtGaSHZXKaV/F/E0Y6CqaygLe5B2ftGf8IZfz9Ytyh40TGKz98JfaMb4QkbHKatmjK3wJnytQ0qSHf5VTB5hpsduDFRPKIuZQtBZIocVobs9ASO/IlxxAAAA"
   },
   "Metadata": {
    "aws:cdk:path": "GuardDutyStack/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "DetectorId": {
   "Description": "ID del detector de GuardDuty",
   "Value": {
    "Ref": "GuardDutyDetector"
   },
   "Export": {
    "Name": "GuardDutyDetectorId"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}